{
  "experiment": "sphere_bounce_batch",
  "description": "Multi-scene batch for visual dynamics (K=10 ring cameras).",
  "base_config": "configs/sphere_bounce_m2.json",
  "batch_root": "outputs/sphere_bounce_batch",
  "target_scenes": 45,
  "seed": 42,
  "cameras": {
    "num_cameras": 10,
    "train_cameras": [0, 1, 2, 3, 4, 5, 6, 7],
    "test_cameras": [8, 9]
  },
  "sampling": {
    "restitution": { "min": 0.45, "max": 0.85, "steps": 5 },
    "mass_kg": { "min": 0.5, "max": 2.0, "steps": 3 },
    "drop_z_m": { "min": 1.2, "max": 2.0, "steps": 3 }
  },
  "split_ratios": { "train": 0.8, "val": 0.1, "test": 0.1 },
  "naming": "scene_{index:04d}_e{restitution:.2f}_m{mass_kg:.2f}_z{drop_z_m:.2f}"
}
